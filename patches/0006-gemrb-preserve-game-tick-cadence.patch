+++ b/gemrb/core/Interface.cpp
@@ -1038,7 +1038,8 @@ void Interface::Main()
 	tick_t frame = 0;
 	tick_t time = GetMilliseconds();
 	tick_t timebase = time;
-	tick_t lastGameUpdate = 0;
+	static const tick_t oneTick = 1000 / Time.ticksPerSec;
+	tick_t lastGameUpdate = time >= oneTick ? time - oneTick : 0;
 
