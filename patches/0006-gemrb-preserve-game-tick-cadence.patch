 		time = GetMilliseconds();
 
-		static const tick_t oneTick = 1000 / Time.ticksPerSec;
 		bool doGameStateUpdate = time - lastGameUpdate >= oneTick;
 		if (doGameStateUpdate) {
 			GameLoop();
