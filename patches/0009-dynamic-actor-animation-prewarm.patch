diff --git a/gemrb/core/Game.cpp b/gemrb/core/Game.cpp
--- a/gemrb/core/Game.cpp
+++ b/gemrb/core/Game.cpp
@@ -2842 +2842,146 @@
-}
+void Game::QueueActorPreload(Actor* actor)
+{
+	if (!actor || !preloadSeenActors.insert(actor->GetGlobalID()).second) return;
+	preloadActors.push_back(actor->GetGlobalID());
+	preloadActive = true;
+}
+
+void Game::ProcessPreloadQueue()
+{
+	auto queueResource = [this](const ResRef& resource) {
+		if (resource.IsEmpty()) return;
+		std::string key(resource.c_str());
+		if (preloadSeenResources.insert(key).second) preloadResources.push_back(resource);
+	};
+	auto queueEffectResources = [&queueResource](const Effect& effect) {
+		queueResource(effect.Resource);
+		queueResource(effect.Resource2);
+		queueResource(effect.Resource3);
+		queueResource(effect.Resource4);
+	};
+	auto queueActorDependencies = [this, &queueResource](Actor* actor) {
+		if (!actor) return;
+		for (int type = 0; type < actor->spellbook.GetTypes(); ++type) {
+			for (unsigned int level = 0; level < actor->spellbook.GetSpellLevelCount(type); ++level) {
+				unsigned int count = actor->spellbook.GetMemorizedSpellsCount(type, level, false);
+				for (unsigned int index = 0; index < count; ++index) {
+					const CREMemorizedSpell* spell = actor->spellbook.GetMemorizedSpell(type, level, index);
+					if (spell) queueResource(spell->SpellResRef);
+				}
+			}
+		}
+		std::vector<ResRef> refs;
+		for (GameScript* script : actor->Scripts) {
+			if (script) script->CollectResourceRefs(refs);
+		}
+		for (const ResRef& ref : refs) queueResource(ref);
+	};
+
+	AreaPreloader preload;
+	if (!preload.HasMemory()) {
+		preloadActors.clear();
+		preloadResources.clear();
+		preloadPoses.clear();
+		if (preloadActive) {
+			Log(MESSAGE, "Game", "Dynamic preload stopped at the {} KiB memory reserve.", preload.availableKiB);
+			preloadActive = false;
+		}
+		return;
+	}
+
+	if (!preloadActors.empty()) {
+		ieDword actorID = preloadActors.front();
+		preloadActors.pop_front();
+		Actor* actor = GetActorByGlobalID(actorID);
+		if (actor) {
+			queueActorDependencies(actor);
+			const unsigned char stances[] = {
+				IE_ANI_ATTACK, IE_ANI_CAST, IE_ANI_CONJURE, IE_ANI_SHOOT,
+				IE_ANI_DAMAGE, IE_ANI_READY, IE_ANI_ATTACK_SLASH,
+				IE_ANI_ATTACK_BACKSLASH, IE_ANI_ATTACK_JAB, IE_ANI_AWAKE, IE_ANI_WALK
+			};
+			for (unsigned char stance : stances) {
+				for (ieDword orientation = 0; orientation < MAX_ORIENT; ++orientation) {
+					preloadPoses.push_back({ actorID, stance, orientation });
+				}
+			}
+		}
+	} else if (!preloadResources.empty()) {
+		ResRef resource = preloadResources.front();
+		preloadResources.pop_front();
+		++preloadResourceCount;
+
+		if (gamedata->Exists(resource, IE_SPL_CLASS_ID, true)) {
+			const Spell* spell = gamedata->GetSpell(resource, true);
+			if (spell) {
+				for (const Effect& effect : spell->casting_features) queueEffectResources(effect);
+				for (const SPLExtHeader& header : spell->ext_headers) {
+					preload.PrecacheProjectile(header.ProjectileAnimation);
+					for (const Effect& effect : header.features) queueEffectResources(effect);
+				}
+				gamedata->FreeSpell(spell, resource, false);
+			}
+		}
+		if (gamedata->Exists(resource, IE_EFF_CLASS_ID, true)) {
+			Effect* effect = gamedata->GetEffect(resource);
+			if (effect) {
+				queueEffectResources(*effect);
+				if (effect->Projectile) preload.PrecacheProjectile(effect->Projectile);
+				if (effect->Opcode == 0x7f) {
+					static const ResRef summonTables[] = {
+						"MONSUM01", "MONSUM02", "MONSUM03", "ANISUM01", "ANISUM02", "ANISUM03"
+					};
+					unsigned int index = effect->Parameter2 < 5 ? effect->Parameter2 : effect->Parameter2 - 5;
+					queueResource(summonTables[std::min(index, 5U)]);
+				}
+				delete effect;
+			}
+		}
+		if (gamedata->Exists(resource, IE_2DA_CLASS_ID, true)) {
+			AutoTable table = gamedata->LoadTable(resource, true);
+			if (table) {
+				for (TableMgr::index_t row = 0; row < table->GetRowCount(); ++row) {
+					for (TableMgr::index_t column = 0; column < table->GetColumnCount(row); ++column) {
+						queueResource(ResRef(table->QueryField(row, column)));
+					}
+				}
+			}
+		}
+		if (gamedata->Exists(resource, IE_CRE_CLASS_ID, true)) {
+			Actor* actor = gamedata->GetCreature(resource);
+			if (actor) {
+				queueActorDependencies(actor);
+				const std::vector<unsigned char> stances = {
+					IE_ANI_ATTACK, IE_ANI_CAST, IE_ANI_CONJURE, IE_ANI_SHOOT,
+					IE_ANI_DAMAGE, IE_ANI_READY, IE_ANI_ATTACK_SLASH,
+					IE_ANI_ATTACK_BACKSLASH, IE_ANI_ATTACK_JAB
+				};
+				preload.PrecacheActorStances(actor, stances, false);
+				delete actor;
+			}
+		}
+		if (gamedata->Exists(resource, IE_VVC_CLASS_ID, true) ||
+		    gamedata->Exists(resource, IE_BAM_CLASS_ID, true)) {
+			preload.PrecacheVisual(resource);
+		}
+	} else if (!preloadPoses.empty()) {
+		auto pose = preloadPoses.front();
+		preloadPoses.pop_front();
+		Actor* actor = GetActorByGlobalID(pose[0]);
+		if (actor && actor->GetAnims()) {
+			orient_t orientation = static_cast<orient_t>(pose[2]);
+			preload.PrecacheParts(actor->GetAnims()->GetAnimation(pose[1], orientation));
+			preload.PrecacheParts(actor->GetAnims()->GetShadowAnimation(pose[1], orientation));
+		}
+	}
+
+	preloadFrames += preload.frames;
+	if (preloadActive && preloadActors.empty() && preloadResources.empty() && preloadPoses.empty()) {
+		Log(MESSAGE, "Game", "Dynamic preload completed {} resources and {} animation frames; {} KiB available.",
+		    preloadResourceCount, preloadFrames, preload.availableKiB);
+		preloadActive = false;
+	}
+}
+
+
+}
