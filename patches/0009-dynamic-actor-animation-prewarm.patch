+void GameScript::CollectResourceRefs(std::vector<ResRef>& refs) const
+{
+	if (!script) return;
+	for (const ResponseBlock* block : script->responseBlocks) {
+		if (block->condition) {
+			for (const Trigger* trigger : block->condition->triggers) {
+				if (!trigger->resref0Parameter.IsEmpty()) refs.push_back(trigger->resref0Parameter);
+				if (!trigger->resref1Parameter.IsEmpty()) refs.push_back(trigger->resref1Parameter);
+			}
+		}
+		if (!block->responseSet) continue;
+		for (const Response* response : block->responseSet->responses) {
+			for (const Action* action : response->actions) {
+				if (!action->resref0Parameter.IsEmpty()) refs.push_back(action->resref0Parameter);
+				if (!action->resref1Parameter.IsEmpty()) refs.push_back(action->resref1Parameter);
+			}
+		}
+	}
+}
+
 Script* GameScript::CacheScript(const ResRef& resRef, bool AIScript)
 {
 	SClass_ID type = AIScript ? IE_BS_CLASS_ID : IE_BCS_CLASS_ID;
