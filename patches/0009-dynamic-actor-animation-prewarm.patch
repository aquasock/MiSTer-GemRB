diff --git a/gemrb/core/GameScript/GameScript.cpp b/gemrb/core/GameScript/GameScript.cpp
index 999e46e..9ad23e6 100644
--- a/gemrb/core/GameScript/GameScript.cpp
+++ b/gemrb/core/GameScript/GameScript.cpp
@@ -1828,6 +1828,30 @@ GameScript::~GameScript(void)
 	BcsCache.DecRef(Name, true);
 }
 
+void GameScript::CollectSpellRefs(std::vector<ResRef>& refs) const
+{
+	if (!script) return;
+	for (const ResponseBlock* block : script->responseBlocks) {
+		if (!block->responseSet) continue;
+		for (const Response* response : block->responseSet->responses) {
+			for (const Action* action : response->actions) {
+				if (action->actionID >= MAX_ACTIONS) continue;
+				ActionFunction function = actions[action->actionID];
+				bool spellAction = function == GameScript::Spell || function == GameScript::SpellNoDec ||
+					function == GameScript::SpellPoint || function == GameScript::SpellPointNoDec ||
+					function == GameScript::ForceSpell || function == GameScript::ForceSpellRange ||
+					function == GameScript::ForceSpellPoint || function == GameScript::ForceSpellPointRange ||
+					function == GameScript::ReallyForceSpell || function == GameScript::ReallyForceSpellPoint ||
+					function == GameScript::ReallyForceSpellDead || function == GameScript::ApplySpell ||
+					function == GameScript::ApplySpellPoint;
+				if (!spellAction) continue;
+				ResRef spell;
+				if (ResolveSpellName(spell, action)) refs.push_back(spell);
+			}
+		}
+	}
+}
+
 Script* GameScript::CacheScript(const ResRef& resRef, bool AIScript)
 {
 	SClass_ID type = AIScript ? IE_BS_CLASS_ID : IE_BCS_CLASS_ID;
