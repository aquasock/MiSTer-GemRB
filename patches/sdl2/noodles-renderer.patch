--- SDL2-2.32.10.orig/CMakeLists.txt	2026-09-24 00:00:00.000000000 -0700
+++ SDL2-2.32.10/CMakeLists.txt	2026-09-24 00:00:00.000000000 -0700
@@ -491,6 +491,7 @@
 set_option(SDL_OFFSCREEN           "Use offscreen video driver" ON)
 set_option(SDL_MISTER              "Use MiSTer framebuffer video driver" OFF)
 set_option(SDL_MISTERAUDIO         "Use MiSTer audio driver (/dev/MrAudio)" OFF)
+set_option(SDL_RENDER_NOODLES      "Use MiSTer-Noodles 2D render driver" OFF)
 option_string(SDL_BACKGROUNDING_SIGNAL "number to use for magic backgrounding signal or 'OFF'" OFF)
