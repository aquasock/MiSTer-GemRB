diff -ruN SDL2-2.32.10.orig/CMakeLists.txt SDL2-2.32.10/CMakeLists.txt
--- SDL2-2.32.10.orig/CMakeLists.txt	2026-09-24 00:00:00.000000000 -0700
+++ SDL2-2.32.10/CMakeLists.txt	2026-09-24 00:00:00.000000000 -0700
@@ -491,6 +491,7 @@
 set_option(SDL_OFFSCREEN           "Use offscreen video driver" ON)
 set_option(SDL_MISTER              "Use MiSTer framebuffer video driver" OFF)
 set_option(SDL_MISTERAUDIO         "Use MiSTer audio driver (/dev/MrAudio)" OFF)
+set_option(SDL_RENDER_NOODLES      "Use MiSTer-Noodles 2D render driver" OFF)
 option_string(SDL_BACKGROUNDING_SIGNAL "number to use for magic backgrounding signal or 'OFF'" OFF)
 option_string(SDL_FOREGROUNDING_SIGNAL "number to use for magic foregrounding signal or 'OFF'" OFF)
 set_option(SDL_HIDAPI              "Enable the HIDAPI subsystem" ON)
@@ -1271,6 +1272,19 @@
     set(HAVE_MISTER TRUE)
     set(HAVE_SDL_VIDEO TRUE)
   endif()
+  if(SDL_RENDER_NOODLES)
+    set(SDL_VIDEO_RENDER_NOODLES 1)
+    file(GLOB RENDER_NOODLES_SOURCES ${SDL2_SOURCE_DIR}/src/render/noodles/*.c)
+    list(APPEND SOURCE_FILES ${RENDER_NOODLES_SOURCES})
+    find_path(NOODLES_INCLUDE_DIR noodles_link.h HINTS ${NOODLES_ROOT}/include)
+    find_library(NOODLES_LIBRARY noodles HINTS ${NOODLES_ROOT}/lib)
+    if(NOT NOODLES_INCLUDE_DIR OR NOT NOODLES_LIBRARY)
+      message(FATAL_ERROR "SDL_RENDER_NOODLES needs the MiSTer-Noodles SDK")
+    endif()
+    include_directories(${NOODLES_INCLUDE_DIR})
+    list(APPEND EXTRA_LIBS ${NOODLES_LIBRARY})
+    set(HAVE_RENDER_NOODLES TRUE)
+  endif()
   if(SDL_OFFSCREEN)
     set(SDL_VIDEO_DRIVER_OFFSCREEN 1)
     file(GLOB VIDEO_OFFSCREEN_SOURCES ${SDL2_SOURCE_DIR}/src/video/offscreen/*.c)
