+  if(SDL_RENDER_NOODLES)
+    set(SDL_VIDEO_RENDER_NOODLES 1)
+    file(GLOB RENDER_NOODLES_SOURCES ${SDL2_SOURCE_DIR}/src/render/noodles/*.c)
+    list(APPEND SOURCE_FILES ${RENDER_NOODLES_SOURCES})
+    find_path(NOODLES_INCLUDE_DIR noodles_link.h HINTS ${NOODLES_ROOT}/include)
+    find_library(NOODLES_LIBRARY noodles HINTS ${NOODLES_ROOT}/lib)
+    if(NOT NOODLES_INCLUDE_DIR OR NOT NOODLES_LIBRARY)
+      message(FATAL_ERROR "SDL_RENDER_NOODLES needs the MiSTer-Noodles SDK")
+    endif()
+    include_directories(${NOODLES_INCLUDE_DIR})
+    list(APPEND EXTRA_LIBS ${NOODLES_LIBRARY})
+    set(HAVE_RENDER_NOODLES TRUE)
+  endif()
   if(SDL_OFFSCREEN)
     set(SDL_VIDEO_DRIVER_OFFSCREEN 1)
     file(GLOB VIDEO_OFFSCREEN_SOURCES ${SDL2_SOURCE_DIR}/src/video/offscreen/*.c)
