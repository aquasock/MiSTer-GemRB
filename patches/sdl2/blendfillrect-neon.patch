+#if defined(__ARM_NEON) && SDL_BYTEORDER == SDL_LIL_ENDIAN
+#include <arm_neon.h>
+
+/* floor(x / 255) for 0 <= x <= 255 * 255, exactly, without a division */
+static SDL_INLINE uint8x8_t blendfill_div255(uint16x8_t x)
+{
+    return vmovn_u16(vshrq_n_u16(vaddq_u16(vaddq_u16(x, vdupq_n_u16(1)), vshrq_n_u16(x, 8)), 8));
+}
+
+/* SDL_BLENDMODE_BLEND fill of an ARGB8888 rectangle, 8 pixels at a time. r, g and b are already multiplied by a.
+   Gives the same result as DRAW_SETPIXEL_BLEND_ARGB8888. */
+static void SDL_BlendFillRect_ARGB8888_BlendNEON(SDL_Surface *dst, const SDL_Rect *rect, Uint8 r, Uint8 g, Uint8 b, Uint8 a)
+{
+    const unsigned inva = 0xff - a;
+    const uint8x8_t vinv = vdup_n_u8((uint8_t)inva);
+    const uint8x8_t vr = vdup_n_u8(r), vg = vdup_n_u8(g), vb = vdup_n_u8(b), va = vdup_n_u8(a);
+    const int pitch = dst->pitch / 4;
+    int y;
+
+    for (y = 0; y < rect->h; y++) {
+        Uint32 *pixel = (Uint32 *)dst->pixels + (rect->y + y) * pitch + rect->x;
+        int x = 0;
+
+        for (; x + 8 <= rect->w; x += 8, pixel += 8) {
+            uint8x8x4_t px = vld4_u8((const uint8_t *)pixel); /* B, G, R, A */
+            px.val[0] = vadd_u8(blendfill_div255(vmull_u8(px.val[0], vinv)), vb);
+            px.val[1] = vadd_u8(blendfill_div255(vmull_u8(px.val[1], vinv)), vg);
+            px.val[2] = vadd_u8(blendfill_div255(vmull_u8(px.val[2], vinv)), vr);
+            px.val[3] = vadd_u8(blendfill_div255(vmull_u8(px.val[3], vinv)), va);
+            vst4_u8((uint8_t *)pixel, px);
+        }
+        for (; x < rect->w; x++, pixel++) {
+            unsigned sa = *pixel >> 24, sr = (*pixel >> 16) & 0xff, sg = (*pixel >> 8) & 0xff, sb = *pixel & 0xff;
+            sr = DRAW_MUL(inva, sr) + r;
+            sg = DRAW_MUL(inva, sg) + g;
+            sb = DRAW_MUL(inva, sb) + b;
+            sa = DRAW_MUL(inva, sa) + a;
+            *pixel = (sa << 24) | (sr << 16) | (sg << 8) | sb;
+        }
+    }
+}
+#endif
