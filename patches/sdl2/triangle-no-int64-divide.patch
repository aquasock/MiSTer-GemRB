+/* The Cortex-A9 and other CPUs without a hardware 64-bit divide spend hundreds of cycles per division, and the
+   interpolation below divides four times per pixel by the same triangle area. Multiply by the reciprocal in double
+   precision instead (a tiny bias keeps exact multiples from truncating one too low). */
+static SDL_INLINE int triangle_div(Sint64 num, double area_inv)
+{
+    double q = (double)num * area_inv;
+    return (int)(q + (q >= 0 ? 1e-7 : -1e-7));
+}
