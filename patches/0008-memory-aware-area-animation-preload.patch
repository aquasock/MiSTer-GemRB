+constexpr size_t PreloadReserveKiB = 80 * 1024;
+
+size_t AvailableMemoryKiB()
+{
+	std::ifstream meminfo("/proc/meminfo");
+	std::string field;
+	size_t value = 0;
+	std::string unit;
+	while (meminfo >> field >> value >> unit) {
+		if (field == "MemAvailable:") return value;
+	}
+	return std::numeric_limits<size_t>::max();
+}
+
+struct AreaPreloader {
+	std::set<std::string> resources;
+	std::set<size_t> projectiles;
+	std::vector<Factory::object_t> pinnedFactories;
+	size_t frames = 0;
+	size_t availableKiB = AvailableMemoryKiB();
+	bool stopped = false;
+
+	bool HasMemory()
+	{
+		availableKiB = AvailableMemoryKiB();
+		if (availableKiB == std::numeric_limits<size_t>::max()) return true;
+		if (availableKiB < PreloadReserveKiB) {
+			gamedata->TrimFactoryCache(32);
+			availableKiB = AvailableMemoryKiB();
+			if (availableKiB < PreloadReserveKiB) {
+				stopped = true;
+				return false;
+			}
+		}
+		return true;
+	}
+
+	void PrecacheAnimation(const Animation* animation)
+	{
+		if (!animation) return;
+		for (Animation::index_t i = 0; i < animation->GetFrameCount(); ++i) {
+			if (!HasMemory()) return;
+			auto frame = animation->GetFrame(i);
+			if (!frame) continue;
+			VideoDriver->PrecacheSprite(frame);
+			++frames;
+		}
+	}
+
+	void PrecacheParts(const CharAnimations::PartAnim* parts)
+	{
+		if (!parts) return;
+		for (const auto& animation : *parts) {
+			if (stopped) return;
+			PrecacheAnimation(animation.get());
+		}
+	}
+
+	void PrecacheBAM(const ResRef& resource)
+	{
+		if (resource.IsEmpty() || !HasMemory()) return;
+		std::string key = "bam:" + std::string(resource.c_str());
+		if (!resources.insert(key).second) return;
+		auto factory = gamedata->GetFactoryResourceAs<AnimationFactory>(resource, IE_BAM_CLASS_ID, true);
+		if (!factory) return;
+		pinnedFactories.push_back(factory);
+		for (AnimationFactory::index_t i = 0; i < factory->GetFrameCount(); ++i) {
+			if (!HasMemory()) return;
+			auto frame = factory->GetFrameWithoutCycle(i);
+			if (!frame) continue;
+			VideoDriver->PrecacheSprite(frame);
+			++frames;
+		}
+	}
+
+	void PrecacheVisual(const ResRef& resource)
+	{
+		if (resource.IsEmpty() || !HasMemory()) return;
+		if (!gamedata->Exists(resource, IE_VVC_CLASS_ID, true)) {
+			PrecacheBAM(resource);
+			return;
+		}
+		std::string key = "vvc:" + std::string(resource.c_str());
+		if (!resources.insert(key).second) return;
+		ScriptedAnimation* visual = gamedata->GetScriptedAnimation(resource, false);
+		if (!visual) return;
+		for (Animation* animation : visual->anims) {
+			if (stopped) break;
+			PrecacheAnimation(animation);
+		}
+		if (!stopped && visual->light && HasMemory()) VideoDriver->PrecacheSprite(visual->light);
+		delete visual;
+	}
+
+	void PrecacheEffectResources(const Effect& effect)
+	{
+		const ResRef* refs[] = { &effect.Resource, &effect.Resource2, &effect.Resource3, &effect.Resource4 };
+		for (const ResRef* resource : refs) {
+			if (resource->IsEmpty()) continue;
+			if (gamedata->Exists(*resource, IE_VVC_CLASS_ID, true) ||
+			    gamedata->Exists(*resource, IE_BAM_CLASS_ID, true)) {
+				PrecacheVisual(*resource);
+			}
+		}
+	}
+
+	void PrecacheProjectile(size_t index, unsigned int depth = 0)
+	{
+		if (depth > 2 || !HasMemory() || !projectiles.insert(index).second) return;
+		Projectile* projectile = core->GetProjectileServer()->GetProjectileByIndex(index);
+		if (!projectile) return;
+		PrecacheVisual(projectile->BAMRes1);
+		PrecacheVisual(projectile->BAMRes2);
+		PrecacheVisual(projectile->TravelVVC);
+		for (const ResRef& trail : projectile->TrailBAM) PrecacheVisual(trail);
+		if (projectile->Extension) {
+			PrecacheVisual(projectile->Extension->VVCRes);
+			PrecacheVisual(projectile->Extension->Spread);
+			PrecacheVisual(projectile->Extension->Secondary);
+			PrecacheProjectile(projectile->Extension->ExplProjIdx, depth + 1);
+			PrecacheProjectile(projectile->Extension->FragProjIdx, depth + 1);
+		}
+		delete projectile;
+	}
+
+	void PrecacheSpell(const ResRef& resource)
+	{
+		std::string key = "spl:" + std::string(resource.c_str());
+		if (resource.IsEmpty() || !HasMemory() || !resources.insert(key).second) return;
+		const Spell* spell = gamedata->GetSpell(resource, true);
+		if (!spell) return;
+		for (const Effect& effect : spell->casting_features) PrecacheEffectResources(effect);
+		for (const SPLExtHeader& header : spell->ext_headers) {
+			PrecacheProjectile(header.ProjectileAnimation);
+			for (const Effect& effect : header.features) PrecacheEffectResources(effect);
+		}
+		gamedata->FreeSpell(spell, resource, false);
+	}
+
+};
+
+}
