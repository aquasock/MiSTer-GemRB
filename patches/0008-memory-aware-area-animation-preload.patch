+
+size_t Factory::TrimUnused(size_t maxObjects)
+{
+	size_t removed = 0;
+	while (removed < maxObjects) {
+		auto oldest = fobjects.end();
+		uint64_t oldestUse = std::numeric_limits<uint64_t>::max();
+		for (auto it = fobjects.begin(); it != fobjects.end(); ++it) {
+			if (it->object.use_count() == 1 && it->lastUse < oldestUse) {
+				oldest = it;
+				oldestUse = it->lastUse;
+			}
+		}
+		if (oldest == fobjects.end()) break;
+		fobjects.erase(oldest);
+		++removed;
+	}
+	return removed;
 }
 
 }
