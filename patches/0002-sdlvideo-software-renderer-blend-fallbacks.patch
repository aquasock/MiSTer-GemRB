+	// The software renderer cannot set custom blend modes. GemRB uses them to hide characters behind walls (the
+	// stencil pass) and for some glow effects, and without them the stencil is drawn opaque over the character.
+	// Detect it, and fall back to plain drawing and the standard additive blend.
+	if (SDL_Texture* probe = SDL_CreateTexture(renderer, SDL_PIXELFORMAT_ARGB8888, SDL_TEXTUREACCESS_STATIC, 1, 1)) {
+		customBlendModes = SDL_SetTextureBlendMode(probe, stencilAlphaBlender) == 0;
+		SDL_DestroyTexture(probe);
+	}
+	if (!customBlendModes) {
+		Log(WARNING, "SDL20Video", "Renderer lacks custom blend modes: characters are not hidden behind walls, and glow effects are approximated");
+	}
