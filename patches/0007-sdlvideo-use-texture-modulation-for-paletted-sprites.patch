+SDL_Texture* SDLTextureSprite2D::GetTexture(SDL_Renderer* renderer, const Palette& palette) const
+{
+	SDL_Surface* source = GetSurface();
+	if (!source->format->palette) return GetTexture(renderer);
+
+	const version_t version = palette.GetVersion();
+	for (auto it = paletteTextures.begin(); it != paletteTextures.end(); ++it) {
+		if (it->version != version) continue;
+		PaletteTexture cached = *it;
+		paletteTextures.erase(it);
+		paletteTextures.push_back(cached);
+		return cached.texture;
+	}
+
+	SDL_Surface* paletted = SDL_CreateRGBSurfaceFrom(source->pixels, source->w, source->h,
+						       source->format->BitsPerPixel, source->pitch, 0, 0, 0, 0);
+	if (!paletted) return nullptr;
+	SDLVideoDriver::SetSurfacePalette(paletted, reinterpret_cast<const SDL_Color*>(palette.ColorData()),
+					  0x01 << source->format->BitsPerPixel);
+	SDL_SetColorKey(paletted, SDL_bool(format.HasColorKey), GetColorKey());
+	SDL_Texture* variant = SDL_CreateTextureFromSurface(renderer, paletted);
+	SDL_FreeSurface(paletted);
+	if (!variant) return nullptr;
+
+	constexpr size_t MaxPaletteTextures = 4;
+	if (paletteTextures.size() == MaxPaletteTextures) {
+		SDL_DestroyTexture(paletteTextures.front().texture);
+		paletteTextures.erase(paletteTextures.begin());
+	}
+	paletteTextures.push_back({ version, variant });
+	return variant;
+}
+
+void SDLTextureSprite2D::ClearPaletteTextures() const noexcept
+{
+	for (const PaletteTexture& cached : paletteTextures) SDL_DestroyTexture(cached.texture);
+	paletteTextures.clear();
+}
+
 void SDLTextureSprite2D::OnSurfaceUpdate() const noexcept
 {
 	staleTexture = true;
+	ClearPaletteTextures();
 }
