+void SDL20VideoDriver::PrecacheSprite(const Holder<Sprite2D>& sprite)
+{
+	auto* spr = dynamic_cast<const SDLTextureSprite2D*>(sprite.get());
+	if (!spr) return;
+	spr->PrepareForRendering(BlitFlags::NONE);
+	spr->GetTexture(renderer);
+}
+
+void SDL20VideoDriver::PrecacheSpriteWithPalette(const Holder<Sprite2D>& sprite, const Holder<Palette>& palette)
+{
+	auto* spr = dynamic_cast<const SDLTextureSprite2D*>(sprite.get());
+	if (!spr || !palette) {
+		PrecacheSprite(sprite);
+		return;
+	}
+	spr->PrepareForRendering(BlitFlags::NONE);
+	spr->GetTexture(renderer, *palette);
+}
+
+void SDL20VideoDriver::BlitGameSpriteWithPalette(const Holder<Sprite2D>& spr, const Holder<Palette>& pal,
+						 const Point& p, BlitFlags flags, Color tint)
+{
+	if (!pal || (flags & (BlitFlags::GREY | BlitFlags::SEPIA))) {
+		Video::BlitGameSpriteWithPalette(spr, pal, p, flags, tint);
+		return;
+	}
+	Region src(Point(0, 0), spr->Frame.size);
+	Region dst(p - spr->Frame.origin, spr->Frame.size);
+	BlitSpriteClipped(spr, std::move(src), dst, flags, &tint, pal.get());
+}
