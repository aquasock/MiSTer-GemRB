diff --git a/gemrb/plugins/SDLVideo/SDL20Video.cpp b/gemrb/plugins/SDLVideo/SDL20Video.cpp
--- a/gemrb/plugins/SDLVideo/SDL20Video.cpp
+++ b/gemrb/plugins/SDLVideo/SDL20Video.cpp
@@ -411,7 +411,14 @@ int SDL20VideoDriver::UpdateRenderTarget(const Color* color, BlitFlags flags)
 
 void SDL20VideoDriver::BlitSpriteNativeClipped(const SDLTextureSprite2D* spr, const Region& src, const Region& dst, BlitFlags flags, const SDL_Color* tint)
 {
-	flags &= ~spr->PrepareForRendering(flags, reinterpret_cast<const Color*>(tint));
+	BlitFlags paletteFlags = flags;
+	if (!(flags & (BlitFlags::GREY | BlitFlags::SEPIA))) {
+		// SDL2 can apply ordinary colour and alpha modulation while drawing.
+		// Keep those flags out of the palette state so changing a tint does not
+		// reconvert and upload the complete paletted sprite texture.
+		paletteFlags &= ~(BlitFlags::COLOR_MOD | BlitFlags::ALPHA_MOD);
+	}
+	flags &= ~spr->PrepareForRendering(paletteFlags, reinterpret_cast<const Color*>(tint));
 	SDL_Texture* tex = spr->GetTexture(renderer);
 	BlitSpriteNativeClipped(tex, src, dst, flags, tint);
 }
